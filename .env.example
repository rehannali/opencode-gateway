# ╔══════════════════════════════════════════════════════════════════════╗
# ║                    AI Gateway — Environment Variables               ║
# ╚══════════════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in the values you need.

# ── Gateway Settings ──────────────────────────────────────────────────
# Port exposed to the outside world
GATEWAY_PORT=3000

# Optional: protect the gateway with an API key.
# Clients must send:  Authorization: Bearer <key>  OR  X-Api-Key: <key>
PROXY_API_KEY=

# Server timeout in ms (default 600000 = 10 minutes)
# Increase if your AI queries take longer than 10 minutes
SERVER_TIMEOUT=600000

# Model cache TTL in seconds (default 600 = 10 minutes)
CACHE_TTL=600

# ── opencode Server ──────────────────────────────────────────────────
# Optional: password-protect the opencode server (HTTP basic auth)
OPENCODE_SERVER_PASSWORD=

# ── Provider API Keys (Optional) ─────────────────────────────────────
# opencode reads these from env automatically.
# For OAuth providers (Copilot, ChatGPT Plus, Claude Pro) you do NOT
# need API keys — use the /auth endpoints to authenticate via browser.

# OpenAI (only needed if you have an API key, NOT needed for ChatGPT Plus/Pro)
OPENAI_API_KEY=

# Anthropic (only needed if you have an API key, NOT needed for Claude Pro/Max)
ANTHROPIC_API_KEY=

# OpenRouter (has free-tier models at openrouter.ai)
OPENROUTER_API_KEY=

# Groq (has a generous free tier)
GROQ_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# xAI (Grok)
XAI_API_KEY=
